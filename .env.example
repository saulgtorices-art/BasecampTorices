# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Nunca la expongas en el navegador ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Avisos por correo (Gmail). Ver README → "Avisos por correo".
CORREO_USUARIO=avisos.torices@gmail.com
# Contraseña de aplicación de Google (16 letras), NO la contraseña normal.
CORREO_CONTRASENA=xxxx xxxx xxxx xxxx
# Mismo valor que public.config_avisos_correo.secreto
AVISOS_CORREO_SECRETO=
# Opcional: dominio para los enlaces del correo (por defecto el de producción de Vercel)
APP_URL=
