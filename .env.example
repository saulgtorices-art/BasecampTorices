# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Nunca la expongas en el navegador ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auditorías UX/UI
# Google Cloud → APIs → habilita "PageSpeed Insights API" → Credenciales → API key.
PAGESPEED_API_KEY=
# console.anthropic.com → API keys. Sin ella el reporte sale sin redacción con IA.
ANTHROPIC_API_KEY=
# Opcional. Modelo para redactar el reporte.
# ANTHROPIC_MODEL=claude-sonnet-5-5
